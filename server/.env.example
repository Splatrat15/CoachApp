# Copy this file to .env and fill in your MongoDB Atlas connection string.
# File: server/.env

# MongoDB Atlas → Connect → Drivers → copy connection string, then replace <password>
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/coachapp?retryWrites=true&w=majority

# API port (default 3001)
PORT=3001

# Optional: restrict CORS in production (comma-separated origins)
# CORS_ORIGIN=http://localhost:8081
